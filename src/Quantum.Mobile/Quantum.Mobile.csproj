<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios;net10.0-maccatalyst;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(QuantumMobileTargetFramework)' != ''">$(QuantumMobileTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Quantum.MobileApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Quantum Mobile</ApplicationTitle>
    <ApplicationId>io.quantum.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.1.13</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls"/>
    <ProjectReference Include="../Quantum.Mobile.Core/Quantum.Mobile.Core.csproj"/>
    <ProjectReference Include="../Quantum.Mobile.Debugging/Quantum.Mobile.Debugging.csproj" Condition="'$(Configuration)' == 'Debug'"/>
    <MauiAsset Include="../../LICENSE" LogicalName="LICENSE"/>
    <MauiAsset Include="../../NOTICE" LogicalName="NOTICE"/>
    <MauiIcon Include="Resources\appicon.svg" Color="#181824"/>
    <MauiSplashScreen Include="Resources\appicon.svg" Color="#181824" BaseSize="128,128"/>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Components/Pages/MainPage.Debug.cs;Components/Pages/MainPage.Preview.cs"/>
  </ItemGroup>
</Project>
